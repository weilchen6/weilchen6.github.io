{% if site.clustrmaps.enabled %}
  <section class="clustrmaps-widget mt-5 mb-4 text-center" aria-labelledby="clustrmaps-heading">
    {% if site.clustrmaps.heading %}
      <h2 id="clustrmaps-heading" class="text-center">
        <b style="color: inherit">{{ site.clustrmaps.heading }}</b>
      </h2>
    {% endif %}
    <div
      class="clustrmaps-inner clustrmaps-inner--compact mx-auto"
      {% if site.clustrmaps.max_width %}
        style="max-width: {{ site.clustrmaps.max_width }}"
      {% endif %}
    >
      {% include clustrmaps_snippet.html %}
    </div>
  </section>
{% endif %}
